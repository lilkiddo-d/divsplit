# Chain the app talks to (4663 = Robinhood Chain mainnet; a local anvil fork keeps 4663)
NEXT_PUBLIC_CHAIN_ID=4663
# JSON-RPC used by the app. Local fork: http://127.0.0.1:8555
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id (optional; injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $DIVS project token address. EMPTY = all token features (staking, fee share, listing votes) are hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO country codes denied by middleware (uses Vercel's x-vercel-ip-country).
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
NEXT_PUBLIC_DEV_IMPERSONATE=
